# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer le .env.
DJANGO_SETTINGS_MODULE=SiteDFmac.production
SECRET_KEY=a-generer-avec-python-c-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=bending-iron.com,www.bending-iron.com
CSRF_TRUSTED_ORIGINS=https://bending-iron.com,https://www.bending-iron.com
SITE_URL=https://www.bending-iron.com

# Base de données (DB_ENGINE=sqlite pour tester sans MySQL)
DB_ENGINE=mysql
DB_NAME=bendingiron_db
DB_USER=bendingiron
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306
# Utilisé uniquement par le conteneur MySQL de docker-compose
MYSQL_ROOT_PASSWORD=

# E-mail
EMAIL_HOST=smtp.hostinger.com
EMAIL_HOST_USER=contact@bending-iron.com
EMAIL_HOST_PASSWORD=
# Reçoit le détail de chaque erreur 500 (plusieurs adresses : séparer par des virgules)
ERREURS_EMAIL=

# MTN MoMo
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_HOST=

# Orange Money
OM_BASE_URL=https://api-s1.orange.cm
OM_CONSUMER_KEY=
OM_CONSUMER_SECRET=
OM_API_USER=
OM_API_PASSWORD=
OM_PIN=
OM_CHANNEL_USER_MSISDN=
OM_NOTIF_URL=https://www.bending-iron.com/paiements/notif/orange/

GUNICORN_WORKERS=4
LOG_LEVEL=INFO
